.env
.env.*
*.env.local

# 密钥、证书、签名文件（Android 签名 keystore 等）
*.jks
*.keystore
*.p12
*.pfx
*.key
*.pem
*.crt
*.cer
signing.properties
keystore.properties
local.properties

# 本地凭据 / 配对密钥 / token
*credentials*
*secret*
secrets.toml
secrets.json
*.token

# 含真实手机号、短信原文、真实验证码的测试数据
**/testdata/real/
**/*_real.*
sms_samples/

